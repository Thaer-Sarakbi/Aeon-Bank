{
  "expo": {
    "name": "aeon",
    "slug": "aeon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aeon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.thaer.aeon",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "activator",
          "cydia",
          "filza",
          "sileo",
          "undecimus",
          "zbra",
          "anygofree",
          "xgpspro",
          "acc.GpsManager",
          "LocationSimulation",
          "locationfakelocation"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thaer.aeon"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ef23b8",
          "image": "./assets/icons/aeon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1f6c2231-fa3e-4d96-8ad1-28d585f488b0"
      }
    },
    "owner": "thaer"
  }
}
